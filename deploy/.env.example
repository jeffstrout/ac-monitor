# Copy to deploy/.env to override defaults. All values are optional.

# Which published image tag to run (latest = newest push to main).
IMAGE_TAG=latest

# Host port for the web dashboard/API (container always listens on 8000).
HOST_PORT=8000

# Local timezone for logs/dashboard (defaults to UTC).
TZ=America/Chicago

# Path to the mounted config file inside the container.
CONFIG_FILE=/data/config.yaml

# --- Watchtower auto-update tuning ---
# How often (seconds) the Pi checks GHCR for a newer image. 1200 = ~20 min.
WATCHTOWER_POLL_INTERVAL=1200
# Docker Engine API version Watchtower speaks (1.40 = daemon minimum).
DOCKER_API_VERSION=1.40
